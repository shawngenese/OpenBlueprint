# Database — PostgreSQL (Supabase/Neon) — required for Prisma
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true
# Neon:     postgresql://[USER]:[PASSWORD]@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/project_consultant?schema=public"

# Auth.js (NextAuth v5) — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-32-byte-base64"
AUTH_URL="http://localhost:3000"
# For production on Vercel, set AUTH_URL to your deployment URL, e.g. https://your-app.vercel.app

# OAuth — optional but recommended; create at:
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_SECRET=""

# AI — Gemini only (free) via https://aistudio.google.com/app/apikey — uses gemini-2.0-flash
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""
